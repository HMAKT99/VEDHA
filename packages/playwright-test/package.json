  "dependencies": {
    "@vedha/adapter-playwright": "workspace:*",
    "@vedha/core": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
